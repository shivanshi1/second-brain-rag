DATABASE_URL=postgresql+psycopg://secondbrain:secondbrain@localhost:5432/secondbrain
REDIS_URL=redis://localhost:6379/0

# Leave empty to disable API-key auth (fine for local dev)
API_KEY=

UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=25

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
CHUNK_MAX_WORDS=300
CHUNK_OVERLAP_WORDS=40

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LOG_LEVEL=INFO
